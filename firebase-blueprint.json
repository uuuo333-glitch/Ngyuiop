{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public display metadata for an authenticated user (non-PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "User Private PII",
      "description": "Isolated PII document storing email, phone, and shipping address for a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID."
        },
        "email": {
          "type": "string",
          "maxLength": 180,
          "description": "User email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "User phone number."
        },
        "nationalAddress": {
          "type": "string",
          "maxLength": 60,
          "description": "Saudi National Address short code."
        },
        "address": {
          "type": "string",
          "maxLength": 300,
          "description": "Detailed shipping address."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["uid", "updatedAt"]
    },
    "WishlistItem": {
      "title": "Wishlist Item",
      "description": "Cloud-synced favorite product saved by a customer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent user document."
        },
        "productId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Catalog product ID."
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Saved product name."
        },
        "priceSar": {
          "type": "number",
          "description": "Product price in SAR."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Primary product image URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["userId", "productId", "productName", "priceSar", "createdAt", "updatedAt"]
    },
    "DriveBackupRecord": {
      "title": "Google Drive Backup Record",
      "description": "Index record linking an uploaded backup, catalog export, or PDF guide to Google Drive.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID who uploaded the file to Google Drive."
        },
        "driveFileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Google Drive file ID."
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "File name on Google Drive."
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "MIME type of the Drive file."
        },
        "category": {
          "type": "string",
          "enum": ["store_backup", "product_media", "install_guide", "invoice"],
          "description": "Logical store category for the Drive asset."
        },
        "webViewLink": {
          "type": "string",
          "maxLength": 1000,
          "description": "Direct Google Drive web view URL."
        },
        "sizeBytes": {
          "type": "number",
          "description": "File size in bytes."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Lifecycle status of the backup record."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerUid",
        "driveFileId",
        "fileName",
        "mimeType",
        "category",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreProduct": {
      "title": "Store Product",
      "description": "Catalog product saved by the store owner in Firestore (without private sourcing cost/URL fields).",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "productId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Product ID matching document ID."
        },
        "sku": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional SKU code."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Arabic product title."
        },
        "nameEn": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional English product title."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Store category."
        },
        "priceSar": {
          "type": "number",
          "description": "Retail price in SAR."
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "description": "Product description in Arabic."
        },
        "images": {
          "type": "array",
          "description": "Product image URLs (max 12)."
        },
        "sizes": {
          "type": "array",
          "description": "Available product sizes or dimensions (max 20)."
        },
        "inStock": {
          "type": "boolean",
          "description": "Stock availability flag."
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether product is publicly visible."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp."
        }
      },
      "required": [
        "ownerUid",
        "productId",
        "name",
        "category",
        "priceSar",
        "description",
        "images",
        "inStock",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminGrant": {
      "title": "Admin Grant",
      "description": "Database-backed admin authorization record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID."
        },
        "email": {
          "type": "string",
          "maxLength": 180,
          "description": "Admin email."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Role identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Grant timestamp."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "StorefrontConfig": {
      "title": "Storefront Public Config",
      "description": "Manually edited storefront brand name, tagline, and top-bar logo URL managed by verified admins.",
      "type": "object",
      "properties": {
        "configId": {
          "type": "string",
          "enum": ["public"],
          "description": "Fixed public configuration document identifier."
        },
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Storefront brand title shown in top navigation bar and hero."
        },
        "storeTagline": {
          "type": "string",
          "maxLength": 300,
          "description": "Short Arabic storefront subtitle."
        },
        "storeLogoUrl": {
          "type": "string",
          "maxLength": 1500,
          "description": "Top-bar emblem image URL."
        },
        "themePreset": {
          "type": "string",
          "maxLength": 40,
          "description": "Active theme preset key."
        },
        "primaryGoldColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Primary brand/button accent hex color."
        },
        "secondaryColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Secondary accent hex color."
        },
        "backgroundColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Page background hex color."
        },
        "surfaceColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Product card background hex color."
        },
        "textColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Primary text hex color."
        },
        "themeFontFamily": {
          "type": "string",
          "maxLength": 64,
          "description": "Selected Arabic typography family."
        },
        "cardStyle": {
          "type": "string",
          "maxLength": 40,
          "description": "Product card visual style key."
        },
        "buttonStyle": {
          "type": "string",
          "maxLength": 40,
          "description": "Button visual style key."
        },
        "productsSectionBgUrl": {
          "type": "string",
          "maxLength": 1500,
          "description": "Optional background image URL for products section."
        },
        "productsSectionBgOpacity": {
          "type": "number",
          "description": "Opacity for products section background overlay."
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of admin who saved this configuration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["configId", "storeName", "storeTagline", "updatedByUid", "updatedAt"]
    },
    "PromoBannerDoc": {
      "title": "Promotional Banner Document",
      "description": "Manually or AI created promotional offer banner displayed on storefront and synced to Firestore.",
      "type": "object",
      "properties": {
        "bannerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Banner ID matching the document ID."
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID that created the banner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Banner headline."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 1000,
          "description": "Banner description text."
        },
        "ctaText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Call-to-action button label."
        },
        "ctaUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional CTA target URL or section hash."
        },
        "discountLabel": {
          "type": "string",
          "maxLength": 120,
          "description": "Offer badge label."
        },
        "accentColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Hex accent color."
        },
        "isActive": {
          "type": "boolean",
          "description": "Public storefront visibility flag."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "bannerId",
        "ownerUid",
        "title",
        "subtitle",
        "ctaText",
        "accentColor",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Non-PII profile document for signed-in users."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only private PII document (email, phone, address)."
    },
    "/users/{userId}/wishlists/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "User-scoped saved wishlist items synchronized to Firestore."
    },
    "/users/{userId}/driveBackups/{backupId}": {
      "schema": { "$ref": "#/entities/DriveBackupRecord" },
      "description": "Google Drive file & backup index records linked to the owner user."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/StoreProduct" },
      "description": "Owner-scoped imported and edited products stored in Firebase Firestore."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/StoreProduct" },
      "description": "Public catalog products mirrored by admin."
    },
    "/storefront/{docId}": {
      "schema": { "$ref": "#/entities/StorefrontConfig" },
      "description": "Public storefront store name, tagline, and top-bar logo managed by verified admin."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/PromoBannerDoc" },
      "description": "Storefront offer banners managed by verified admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Database-backed admin permissions table."
    }
  }
}
